# ---------------------------------------------------------------
# VelQora backend configuration.  Copy to backend/.env and fill in.
# .env is git-ignored. NEVER commit real keys.  Placeholders only.
# ---------------------------------------------------------------

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API (only needed if the frontend is NOT served by FastAPI)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Leave blank to auto-generate a temporary secret (logins reset on restart). Set a long random value for real use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# false = research works without signing in (hackathon demo). true = every research call needs a token.
REQUIRE_AUTH=false

# ---- Tavily (web research) ----  https://app.tavily.com  -> free "Researcher" plan API key
TAVILY_API_KEY=
# basic = 1 credit per search (recommended for the free tier). advanced = 2 credits.
TAVILY_SEARCH_DEPTH=basic
# One briefing runs at most this many searches (= credits at basic depth)
TAVILY_MAX_SEARCHES_PER_RESEARCH=6
# Safety net: stop calling Tavily after this many calls per day
TAVILY_DAILY_CALL_CAP=100

# ---- Bifrost (LLM gateway) ----
# Bifrost = the open-source gateway from Maxim AI (github.com/maximhq/bifrost). Run it locally; it
# exposes an OpenAI-compatible API on port 8080 by default.
# Bifrost does NOT include free tokens: add a provider key (Groq, Google Gemini, OpenRouter, ...) inside
# Bifrost's own UI/config, and check that provider's CURRENT free-tier terms yourself.
BIFROST_BASE_URL=http://localhost:8080
# Only needed if your Bifrost instance enforces auth / virtual keys. Leave blank otherwise.
BIFROST_API_KEY=
# bearer = "Authorization: Bearer <key>", virtual_key = "x-bf-vk: <key>"
BIFROST_AUTH_MODE=bearer
# Format is  provider/model-name  and must be a model your Bifrost provider actually offers, e.g.
#   <provider>/<model-id>        (copy the exact id from Bifrost's model list: GET /v1/models)
BIFROST_MODEL=
BIFROST_MAX_TOKENS=1800
BIFROST_TEMPERATURE=0.1
# Set true only if your provider/model supports response_format={"type":"json_object"}
BIFROST_JSON_MODE=false

# ---- Storage & Exports ----
# Directory where generated PowerPoint decks are stored. Defaults to backend/exports/
# On containerized/cloud deployments (Docker, Fly.io, Railway, Render), map this and DATABASE_PATH to a persistent volume.
EXPORTS_DIR=
DATABASE_PATH=

# ---- Behaviour ----
RESEARCH_WINDOW_DAYS=30
# Share of a claim's key words that must appear in its cited source to count as verified (0-1). Higher = stricter.
VERIFY_MIN_OVERLAP=0.6
# Per-IP limits that also protect your free-tier credits
RATE_LIMIT_PER_MINUTE=60
RESEARCH_RATE_LIMIT_PER_HOUR=12
